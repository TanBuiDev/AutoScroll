<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.AutoScroll" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">#07080A</item>
        <item name="android:statusBarColor">#07080A</item>
        <item name="android:windowActionBar">false</item>
    </style>
    <style name="Theme.AutoScroll.Starting" parent="Theme.AutoScroll">
        <item name="android:windowBackground">@drawable/brand_launch_background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">#F7FBFF</item>
        <item name="android:navigationBarColor">#D6EDFF</item>
    </style>
</resources>
